# ~/.config/archivist/env — mode 600. PATH must reach Node 22 or newer.
PATH=/home/you/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
ARCHIVIST_LIBRARY=/srv/library
ARCHIVIST_DATA=/home/you/.local/share/archivist
ARCHIVIST_HOST=0.0.0.0
# no token from Tailscale and the home network; anyone else needs it
ARCHIVIST_TRUSTED=loopback,tailscale,lan
ARCHIVIST_PORT=8780
ARCHIVIST_TOKEN=change-me-to-a-long-random-string
ARCHIVIST_BACKUP_DIR=/home/you/backups/archivist
