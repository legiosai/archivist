# ~/.config/archivist/env — mode 600. PATH must reach Node 22 or newer.
PATH=/home/you/.nvm/versions/node/v24.14.0/bin:/usr/local/bin:/usr/bin:/bin
ARCHIVIST_LIBRARY=/srv/library
ARCHIVIST_DATA=/home/you/.local/share/archivist
ARCHIVIST_HOST=0.0.0.0
# no token from Tailscale and the home network; anyone else needs it
ARCHIVIST_TRUSTED=loopback,tailscale,lan
ARCHIVIST_PORT=8780
ARCHIVIST_TOKEN=change-me-to-a-long-random-string
ARCHIVIST_BACKUP_DIR=/home/you/backups/archivist
# Published through a reverse proxy on this machine? Requests that come through it never count as
# trusted, whatever ARCHIVIST_TRUSTED says. Video stays home unless this is on:
# ARCHIVIST_PROXIED_VIDEO=on
# The proxy's own address, when it is not on this machine (Docker: its network). Default: loopback.
# ARCHIVIST_PROXIES=172.17.0.0/16
# More names that reach it from a trusted network (beyond addresses, one-word names, .ts.net, .local, .lan):
# ARCHIVIST_HOSTS=archivist.home.example
# Posters, synopses, genres and credits: off unless listed. The server sends each work's title and
# year once to the provider and keeps the answer. TMDB needs a token (free); AniList doesn't.
# ARCHIVIST_METADATA=tmdb,anilist
# ARCHIVIST_TMDB_TOKEN=eyJ...
